<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Avoid requiring .NET Framework reference assemblies on Linux/macOS. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net472;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Optimize>true</Optimize>
    <AssemblyName>Loudenvier.FastFileEnumerator.Benchmarking</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Loudenvier.FastFileEnumerator\Loudenvier.FastFileEnumerator.csproj" />
  </ItemGroup>
</Project>
