<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Build the same source files that are copied into Loudenvier.Utils. -->
    <Compile Include="../../Loudenvier.Utils/IO/*.cs" Link="Implementation/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Loudenvier.FastFileEnumerator\Loudenvier.FastFileEnumerator.csproj" />
  </ItemGroup>
</Project>
